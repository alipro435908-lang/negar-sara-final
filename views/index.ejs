<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>نگار سرا | گالری هنری</title>

  <meta
    name="description"
    content="نگار سرا؛ گالری دیجیتال آثار هنری، طراحی گرافیک و هنر خلاقانه"
  >

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <!-- ================= HEADER ================= -->

  <header class="site-header">

    <div class="container navbar">

      <a href="/" class="logo">
        نگار <span>سرا</span>
      </a>

      <button
        class="menu-toggle"
        type="button"
        onclick="toggleMenu()"
        aria-label="باز کردن منو"
      >
        ☰
      </button>

      <nav>
        <ul class="nav-links" id="navLinks">

          <li>
            <a href="/" class="active">خانه</a>
          </li>

          <li>
            <a href="#gallery">گالری آثار</a>
          </li>

          <li>
            <a href="#about">درباره ما</a>
          </li>

          <li>
            <a href="#services">خدمات</a>
          </li>

          <li>
            <a href="#contact">تماس با ما</a>
          </li>

          <li>
            <a href="/blog">بلاگ</a>
          </li>

        </ul>
      </nav>

    </div>

  </header>


  <!-- ================= MAIN ================= -->

  <main>

    <!-- ================= HERO ================= -->

    <section id="home" class="hero">

      <div class="container">

        <div class="hero-content fade-in">

          <div class="hero-label">
            NEGAR SARA GALLERY
          </div>

          <h1>
            هنر،
            <span>فراتر از تصور</span>
          </h1>

          <p>
            دنیایی از زیبایی، خلاقیت و آثار هنری خاص
            در گالری نگار سرا.
          </p>

          <div class="hero-actions">

            <a href="#gallery" class="btn btn-primary">
              مشاهده گالری
            </a>

            <a href="#about" class="btn">
              درباره نگار سرا
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= GALLERY ================= -->

    <section id="gallery">

      <div class="container">

        <div class="section-title">

          <h2>
            گالری آثار هنری
          </h2>

          <p class="section-subtitle">
            مجموعه‌ای از آثار منتخب هنری نگار سرا
          </p>

        </div>


        <div class="gallery-grid">

          <!-- ART 1 -->

          <article class="art-card">

            <div class="art-card-image">

              <img
                src="/images/art-1.jpg"
                alt="اثر هنری زیبایی بی‌نهایت"
                loading="lazy"
              >

            </div>

            <div class="art-card-content">

              <span class="art-category">
                هنر مدرن
              </span>

              <h3>
                زیبایی بی‌نهایت
              </h3>

              <p>
                هنر مدرن و خلاقانه
              </p>

            </div>

          </article>


          <!-- ART 2 -->

          <article class="art-card">

            <div class="art-card-image">

              <img
                src="/images/art-2.jpg"
                alt="اثر هنری رویای طلایی"
                loading="lazy"
              >

            </div>

            <div class="art-card-content">

              <span class="art-category">
                هنر دیجیتال
              </span>

              <h3>
                رویای طلایی
              </h3>

              <p>
                ترکیب رنگ و احساس
              </p>

            </div>

          </article>


          <!-- ART 3 -->

          <article class="art-card">

            <div class="art-card-image">

              <img
                src="/images/art-3.jpg"
                alt="اثر هنری سکوت رنگ‌ها"
                loading="lazy"
              >

            </div>

            <div class="art-card-content">

              <span class="art-category">
                طراحی خلاقانه
              </span>

              <h3>
                سکوت رنگ‌ها
              </h3>

              <p>
                نگاهی متفاوت به هنر
              </p>

            </div>

          </article>

        </div>

      </div>

    </section>


    <!-- ================= FEATURED ================= -->

    <section>

      <div class="container">

        <div class="featured-art">

          <div>

            <img
              src="/images/art-1.jpg"
              alt="اثر منتخب نگار سرا"
              loading="lazy"
            >

          </div>

          <div>

            <span class="art-category">
              اثر منتخب
            </span>

            <h2>
              هنر با نگاه متفاوت
            </h2>

            <p>
              در نگار سرا تلاش می‌کنیم هنر و خلاقیت
              را در فضایی مدرن و متفاوت به نمایش بگذاریم.
            </p>

            <a href="#gallery" class="btn">
              مشاهده آثار
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= SERVICES ================= -->

    <section id="services">

      <div class="container">

        <div class="section-title">

          <h2>
            خدمات نگار سرا
          </h2>

          <p class="section-subtitle">
            خدمات حرفه‌ای برای پروژه‌های خلاقانه شما
          </p>

        </div>


        <div class="gallery-grid">

          <% if (services && services.length > 0) { %>

            <% services.forEach(service => { %>

              <article class="art-card">

                <div class="art-card-content">

                  <span class="art-category">
                    خدمات
                  </span>

                  <h3>
                    <%= service.title %>
                  </h3>

                  <p>
                    <%= service.desc %>
                  </p>

                </div>

              </article>

            <% }) %>

          <% } %>

        </div>

      </div>

    </section>


    <!-- ================= LATEST POSTS ================= -->

    <section>

      <div class="container">

        <div class="section-title">

          <h2>
            آخرین مطالب
          </h2>

          <p class="section-subtitle">
            تازه‌ترین نوشته‌های نگار سرا
          </p>

        </div>


        <% if (posts && posts.length > 0) { %>

          <div class="gallery-grid">

            <% posts.forEach(post => { %>

              <article class="art-card">

                <% if (post.cover) { %>

                  <div class="art-card-image">

                    <img
                      src="<%= post.cover %>"
                      alt="<%= post.title %>"
                      loading="lazy"
                    >

                  </div>

                <% } %>


                <div class="art-card-content">

                  <span class="art-category">
                    بلاگ
                  </span>

                  <h3>
                    <%= post.title %>
                  </h3>


                  <% if (post.excerpt) { %>

                    <p>
                      <%= post.excerpt %>
                    </p>

                  <% } else if (post.content) { %>

                    <p>
                      <%= post.content.substring(0, 150) %>
                      <% if (post.content.length > 150) { %>
                        ...
                      <% } %>
                    </p>

                  <% } %>


                  <% if (post.date) { %>

                    <p>
                      تاریخ انتشار:
                      <%= post.date %>
                    </p>

                  <% } %>


                  <a
                    href="/post/<%= post.slug %>"
                    class="btn"
                  >
                    مطالعه مطلب
                  </a>

                </div>

              </article>

            <% }) %>

          </div>


          <div style="text-align:center; margin-top:30px;">

            <a href="/blog" class="btn btn-primary">
              مشاهده همه مطالب
            </a>

          </div>

        <% } else { %>

          <div class="about-box">

            <p>
              هنوز مطلبی منتشر نشده است.
            </p>

          </div>

        <% } %>

      </div>

    </section>


    <!-- ================= ABOUT ================= -->

    <section id="about">

      <div class="container">

        <div class="about-box">

          <h2 class="section-title">
            درباره نگار سرا
          </h2>

          <p>
            نگار سرا فضایی برای نمایش آثار هنری،
            کشف استعدادها و تجربه زیبایی هنر است.
            هدف ما ایجاد یک تجربه بصری زیبا،
            سریع و مدرن برای علاقه‌مندان به هنر است.
          </p>

        </div>

      </div>

    </section>


    <!-- ================= ORDER ================= -->

    <section id="contact">

      <div class="container">

        <div class="section-title">

          <h2>
            سفارش و همکاری
          </h2>

          <p class="section-subtitle">
            برای سفارش پروژه یا همکاری با نگار سرا
            فرم زیر را تکمیل کنید.
          </p>

        </div>


        <% if (query && query.order === "success") { %>

          <div class="about-box">

            <p>
              درخواست شما با موفقیت ثبت شد.
              به‌زودی با شما تماس خواهیم گرفت.
            </p>

          </div>

        <% } %>


        <% if (query && query.order === "error") { %>

          <div class="about-box">

            <p>
              لطفاً نام، شماره تماس و نوع خدمات را
              به‌درستی وارد کنید.
            </p>

          </div>

        <% } %>


        <form
          class="contact-form"
          action="/order"
          method="POST"
        >

          <div class="form-group">

            <label for="name">
              نام و نام خانوادگی
            </label>

            <input
              id="name"
              name="name"
              type="text"
              placeholder="نام شما"
              required
            >

          </div>


          <div class="form-group">

            <label for="phone">
              شماره تماس
            </label>

            <input
              id="phone"
              name="phone"
              type="tel"
              placeholder="شماره تماس"
              required
            >

          </div>


          <div class="form-group">

            <label for="service">
              نوع خدمات
            </label>

            <select
              id="service"
              name="service"
              required
            >

              <option value="">
                انتخاب خدمات
              </option>

              <% if (services && services.length > 0) { %>

                <% services.forEach(service => { %>

                  <option value="<%= service.title %>">
                    <%= service.title %>
                  </option>

                <% }) %>

              <% } %>

            </select>

          </div>


          <div class="form-group">

            <label for="budget">
              بودجه تقریبی
            </label>

            <input
              id="budget"
              name="budget"
              type="text"
              placeholder="بودجه تقریبی پروژه"
            >

          </div>


          <div class="form-group">

            <label for="message">
              توضیحات پروژه
            </label>

            <textarea
              id="message"
              name="message"
              placeholder="توضیحات پروژه یا درخواست خود را بنویسید..."
            ></textarea>

          </div>


          <button
            type="submit"
            class="btn btn-primary"
          >
            ارسال درخواست
          </button>

        </form>

      </div>

    </section>

  </main>


  <!-- ================= FOOTER ================= -->

  <footer class="site-footer">

    <div class="container">

      <div class="footer-content">


        <div>

          <a href="/" class="logo">
            نگار <span>سرا</span>
          </a>

          <p>
            گالری دیجیتال هنر، طراحی و خلاقیت.
          </p>

        </div>


        <div>

          <h3>
            دسترسی سریع
          </h3>

          <div class="footer-links">

            <a href="/">
              خانه
            </a>

            <a href="#gallery">
              گالری آثار
            </a>

            <a href="#about">
              درباره ما
            </a>

            <a href="/blog">
              بلاگ
            </a>

          </div>

        </div>


        <div>

          <h3>
            ارتباط با ما
          </h3>

          <p>
            برای سفارش پروژه و همکاری
            با نگار سرا در تماس باشید.
          </p>

        </div>


      </div>


      <div class="footer-bottom">

        <p>
          © ۱۴۰۵ نگار سرا | تمامی حقوق محفوظ است.
        </p>

      </div>

    </div>

  </footer>


  <!-- ================= JAVASCRIPT ================= -->

  <script>

    function toggleMenu() {

      const nav = document.getElementById("navLinks");

      if (nav) {
        nav.classList.toggle("open");
      }

    }


    document
      .querySelectorAll(".nav-links a")
      .forEach(function(link) {

        link.addEventListener("click", function() {

          const nav = document.getElementById("navLinks");

          if (nav) {
            nav.classList.remove("open");
          }

        });

      });

  </script>

</body>

</html>
