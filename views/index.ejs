<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>نگار سرا | گالری هنری</title>

  <meta name="description"
        content="نگار سرا؛ گالری دیجیتال آثار هنری، طراحی گرافیک و هنر خلاقانه">

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <!-- ================= HEADER ================= -->

  <header class="site-header">

    <div class="container navbar">

      <a href="#home" class="logo">
        نگار سرا
        <span>NEGAR SARA</span>
      </a>

      <button class="menu-toggle"
              type="button"
              onclick="toggleMenu()">
        ☰
      </button>

      <nav>
        <ul class="nav-links" id="navLinks">

          <li>
            <a href="#home" class="active">
              خانه
            </a>
          </li>

          <li>
            <a href="#gallery">
              گالری آثار
            </a>
          </li>

          <li>
            <a href="#about">
              درباره ما
            </a>
          </li>

          <li>
            <a href="#contact">
              تماس با ما
            </a>
          </li>

        </ul>
      </nav>

    </div>

  </header>


  <!-- ================= MAIN ================= -->

  <main>

    <!-- HERO -->

    <section id="home" class="hero">

      <div class="container">

        <div class="hero-content fade-in">

          <div class="hero-label">
            NEGAR SARA GALLERY
          </div>

          <h1>
            هنر،
            <span>فراتر از تصور</span>
          </h1>

          <p>
            دنیایی از زیبایی، خلاقیت و آثار هنری خاص
            در گالری نگار سرا.
          </p>

          <div class="hero-actions">

            <a href="#gallery"
               class="btn btn-primary">
              مشاهده گالری
            </a>

            <a href="#about"
               class="btn">
              درباره نگار سرا
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= GALLERY ================= -->

    <section id="gallery">

      <div class="container">

        <h2 class="section-title">
          گالری آثار هنری
        </h2>

        <p class="section-subtitle">
          مجموعه‌ای از آثار منتخب هنری نگار سرا
        </p>


        <div class="gallery-grid">


          <!-- ART 1 -->

          <article class="art-card">

            <div class="art-card-image">

              <img
                src="/images/art-1.jpg"
                alt="اثر هنری زیبایی بی‌نهایت"
                loading="lazy"
              >

            </div>

            <div class="art-card-content">

              <span class="art-category">
                هنر مدرن
              </span>

              <h3>
                زیبایی بی‌نهایت
              </h3>

              <p>
                هنر مدرن و خلاقانه
              </p>

            </div>

          </article>


          <!-- ART 2 -->

          <article class="art-card">

            <div class="art-card-image">

              <img
                src="/images/art-2.jpg"
                alt="اثر هنری رویای طلایی"
                loading="lazy"
              >

            </div>

            <div class="art-card-content">

              <span class="art-category">
                هنر دیجیتال
              </span>

              <h3>
                رویای طلایی
              </h3>

              <p>
                ترکیب رنگ و احساس
              </p>

            </div>

          </article>


          <!-- ART 3 -->

          <article class="art-card">

            <div class="art-card-image">

              <img
                src="/images/art-3.jpg"
                alt="اثر هنری سکوت رنگ‌ها"
                loading="lazy"
              >

            </div>

            <div class="art-card-content">

              <span class="art-category">
                طراحی خلاقانه
              </span>

              <h3>
                سکوت رنگ‌ها
              </h3>

              <p>
                نگاهی متفاوت به هنر
              </p>

            </div>

          </article>


        </div>

      </div>

    </section>


    <!-- ================= FEATURED ================= -->

    <section>

      <div class="container">

        <div class="featured-art">

          <div>

            <img
              src="/images/art-1.jpg"
              alt="اثر منتخب نگار سرا"
              loading="lazy"
            >

          </div>

          <div>

            <span class="art-category">
              اثر منتخب
            </span>

            <h2>
              هنر با نگاه متفاوت
            </h2>

            <p>
              در نگار سرا تلاش می‌کنیم هنر و خلاقیت
              را در فضایی مدرن و متفاوت به نمایش بگذاریم.
            </p>

            <a href="#gallery" class="btn">
              مشاهده آثار
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= ABOUT ================= -->

    <section id="about">

      <div class="container">

        <div class="about-box">

          <h2 class="section-title">
            درباره نگار سرا
          </h2>

          <p>
            نگار سرا فضایی برای نمایش آثار هنری،
            کشف استعدادها و تجربه زیبایی هنر است.
            هدف ما ایجاد یک تجربه بصری زیبا،
            سریع و مدرن برای علاقه‌مندان به هنر است.
          </p>

        </div>

      </div>

    </section>


    <!-- ================= CONTACT ================= -->

    <section id="contact">

      <div class="container">

        <h2 class="section-title">
          با ما در ارتباط باشید
        </h2>

        <p class="section-subtitle">
          برای ارتباط با گالری نگار سرا پیام خود را ارسال کنید.
        </p>


        <form
          class="contact-form"
          action="/contact"
          method="POST"
        >

          <div class="form-group">

            <label for="name">
              نام
            </label>

            <input
              id="name"
              name="name"
              type="text"
              placeholder="نام شما"
              required
            >

          </div>


          <div class="form-group">

            <label for="email">
              ایمیل
            </label>

            <input
              id="email"
              name="email"
              type="email"
              placeholder="ایمیل شما"
              required
            >

          </div>


          <div class="form-group">

            <label for="phone">
              شماره تماس
            </label>

            <input
              id="phone"
              name="phone"
              type="tel"
              placeholder="شماره تماس"
            >

          </div>


          <div class="form-group">

            <label for="message">
              پیام
            </label>

            <textarea
              id="message"
              name="message"
              placeholder="پیام خود را بنویسید..."
              required
            ></textarea>

          </div>


          <button
            type="submit"
            class="btn btn-primary"
          >
            ارسال پیام
          </button>

        </form>

      </div>

    </section>

  </main>


  <!-- ================= FOOTER ================= -->

  <footer class="site-footer">

    <div class="container">

      <div class="footer-content">


        <div>

          <h3>
            نگار سرا
          </h3>

          <p>
            گالری دیجیتال هنر، طراحی و خلاقیت.
          </p>

        </div>


        <div>

          <h3>
            دسترسی سریع
          </h3>

          <ul class="footer-links">

            <li>
              <a href="#home">
                خانه
              </a>
            </li>

            <li>
              <a href="#gallery">
                گالری آثار
              </a>
            </li>

            <li>
              <a href="#about">
                درباره ما
              </a>
            </li>

          </ul>

        </div>


        <div>

          <h3>
            ارتباط با ما
          </h3>

          <p>
            برای ارتباط و همکاری
            با نگار سرا در تماس باشید.
          </p>

        </div>


      </div>


      <div class="footer-bottom">

        © ۱۴۰۵ نگار سرا | تمامی حقوق محفوظ است.

      </div>

    </div>

  </footer>


  <!-- ================= JAVASCRIPT ================= -->

  <script>

    function toggleMenu() {

      const nav = document.getElementById("navLinks");

      nav.classList.toggle("open");

    }


    document.querySelectorAll(".nav-links a").forEach(function(link) {

      link.addEventListener("click", function() {

        document
          .getElementById("navLinks")
          .classList.remove("open");

      });

    });

  </script>

</body>
</html>
